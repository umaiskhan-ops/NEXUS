# Sovereign Agentic Mesh — Environment Configuration Template
# Copy this file to .env and fill in your private secrets (never commit .env to git)

# 1. OWNER IDENTITY & CRYPTOGRAPHIC ACCESS
OWNER_TELEGRAM_ID=1000000000
MASTER_PASSPHRASE_HASH=scrypt:32768:8:1:replace_with_salt:replace_with_derived_key
DASHBOARD_TOKEN=replace_with_64_char_random_dashboard_token

# 2. TELEGRAM INTERFACE (Optional)
TELEGRAM_BOT_TOKEN=

# 3. ACCESS CONTROL & LEDGER SIGNING
PEER_SHARED_SECRET=replace_with_64_char_random_peer_secret
LEDGER_HMAC_KEY=replace_with_64_char_random_ledger_hmac_key
HOST=127.0.0.1
PORT=8443

# 4. SWARM INFERENCE ENGINE
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
MESH_CONFIG_JSON=[{"name":"LFM-Worker","role":"Validator","model":"liquid/lfm-2.5-2.6b:free"},{"name":"Nemotron-Fast","role":"Fast Worker","model":"nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"},{"name":"North-Coder","role":"JIT Compiler","model":"cohere/north-mini-code:free"}]
LLM_TIMEOUT_S=120.0
TOKEN_BUDGET=500000

# 5. EXECUTION & SAFETY
ENABLE_CODE_EXECUTION=false
SIMULATE_OFFLINE_CONSENSUS=false
DATA_DIR=./data
